# PostgreSQL 18 local development (create ganeshotsav_dev / ganesh_dev first).
# Use one .env per developer. Never commit or share real credentials.
# If your DB username differs, change it; percent-encode special characters in the password.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ganesh_dev:URL_ENCODE_YOUR_DB_PASSWORD@127.0.0.1:5432/ganeshotsav_dev
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=http://localhost:5173

# Free simulated checkout: Razorpay Dashboard > Test Mode > Test API keys.
# In development/staging use ONLY rzp_test_... keys. In production use ONLY rzp_live_... keys.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local only: enables DEMO-RCP- receipt flow without payment.
# This does NOT call Razorpay, does NOT collect money, and cannot run outside APP_ENV=development.
ENABLE_DEMO_CHECKOUT=1

# AWS S3 Image Uploads (Optional: in development, images save to local directory if unset)
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
