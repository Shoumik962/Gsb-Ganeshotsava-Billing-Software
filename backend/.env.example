# PostgreSQL 18 local development (create ganeshotsav_dev / ganesh_dev first).
# Use one .env per developer. Never commit or share real credentials.
# If your DB username differs, change it; percent-encode special characters in the password.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ganesh_dev:URL_ENCODE_YOUR_DB_PASSWORD@127.0.0.1:5432/ganeshotsav_dev
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=http://localhost:5173

# Free simulated checkout: Razorpay Dashboard > Test Mode > Test API keys.
# In development/staging use ONLY rzp_test_... keys. In production use ONLY rzp_live_... keys.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local only: enables DEMO-RCP- receipt flow without payment.
# Only localhost/loopback + local ganeshotsav_dev; no login/OTP required for DEMO.
# Never enable against real devotee data, a remote DB, a tunnel, or a public server.
# This does NOT call Razorpay, does NOT collect money, and cannot run outside APP_ENV=development.
ENABLE_DEMO_CHECKOUT=1

# AWS S3 Image Uploads (Optional: in development, images save to local directory if unset)
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ------------------- VERIFIED SIGNUP / RECEIPT DELIVERY -------------------
# For local Windows/macOS E2E only, codes print in the FastAPI terminal.
# NEVER use console providers outside development; the backend will refuse them.
EMAIL_PROVIDER=console
SMS_PROVIDER=console
# OPTIONAL: 1 enables a LOCALHOST-ONLY test button for disposable QA users.
# Requires APP_ENV=development and a local ganeshotsav_dev database.
# Never enable for public endpoints, proxies or genuine devotee data.
ENABLE_LOCAL_DEV_VERIFICATION=0
PUBLIC_FRONTEND_URL=http://localhost:5173

# Production email: EMAIL_PROVIDER=smtp; configure your verified sender/SMTP service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Production SMS: SMS_PROVIDER=twilio; configure a suitable transactional SMS sender.
# Provider fees and applicable regional messaging approvals may apply.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
